# Public mode flag only; every credential below remains server-side.
VITE_API_MODE=demo
APP_ORIGIN=https://klane.tech
PORT=8787
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CALLS_PER_MINUTE=12
# Spectrum cloud: Photon project settings. Register allowed project users first.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Server-maintained link from account IDs to verified inbound sender IDs.
PHOTON_USERS={}
# Full Tiger Cloud PostgreSQL connection string; TLS verification is enforced.
TIGER_DATABASE_URL=
SNOWFLAKE_HOST=
SNOWFLAKE_TOKEN=
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Production requires an authenticated gateway to inject this secret and a
# verified x-klane-account identity. Strip these headers from client traffic.
KLANE_GATEWAY_TOKEN=

# ADC alternative: enable the Vertex AI API in your Google Cloud project.
GEMINI_AUTH_MODE=api-key
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional trusted Tiger CA certificate file supplied by Tiger support.
TIGER_CA_FILE=
